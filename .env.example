# Copie para .env. Os valores abaixo são o modo gratuito (tudo local).

# Busca: searxng (gratuito, local) ou serper (Google, pago após 2.500 buscas)
PROVEDOR_BUSCA=searxng
SERPER_API_KEY=
# SEARXNG_URL=http://127.0.0.1:8080

# IA: ollama (gratuito, local) ou claude (pago)
PROVEDOR_IA=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Páginas lidas por busca para completar os dados
MAX_PAGINAS_VISITADAS=3

# Páginas das startups citadas nessas listagens (onde ficam fundador e site oficial)
MAX_PAGINAS_FILHAS=4

# Só para os modos pagos:
# SERPER_API_KEY=
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Opcionais
# PORT=3000
# Contexto do Ollama em tokens (mais contexto = mais texto lido, mais memória usada)
# OLLAMA_NUM_CTX=16384
# Caracteres de cada página enviados à IA
# MAX_CARACTERES_PAGINA=15000
# Tempo máximo para baixar cada página, em segundos
# TEMPO_LIMITE_PAGINA=15
# Sites montados por JavaScript ou com anti-robô: "auto" usa o Playwright se estiver
# instalado (npm install playwright && npx playwright install chromium); "nao" desliga.
# USAR_NAVEGADOR=auto
